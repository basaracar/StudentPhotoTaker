@{
    ViewData["Title"] = "Student Photo Taker";
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h2>Student Photo Taker</h2>
            <div class="form-group">
                <label for="studentId">Student ID</label>
                <input type="text" id="studentId" class="form-control" />
            </div>
            <button id="login" class="btn btn-primary">Login</button>
            <hr />
            <video id="video" width="640" height="480" autoplay style="display: none;"></video>
            <button id="snap" class="btn btn-success" style="display: none;">Take Photo</button>
            <button id="newStudent" class="btn btn-info" style="display: none;">New Student</button>
        </div>
        <div class="col-md-6">
            <h2>Preview</h2>
            <canvas id="canvas" width="640" height="480" style="border: 1px solid #ccc; max-width: 100%;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const studentIdInput = document.getElementById('studentId');
        const loginButton = document.getElementById('login');
        const video = document.getElementById('video');
        const snapButton = document.getElementById('snap');
        const newStudentButton = document.getElementById('newStudent');
        const canvas = document.getElementById('canvas');
        const context = canvas.getContext('2d');

        let stream;
        let videoReady = false;

        // Video hazır olduğunda snap butonunu aktif et
        video.addEventListener('loadedmetadata', () => {
            videoReady = true;
            snapButton.disabled = false;
        });

        loginButton.addEventListener('click', async () => {
            if (studentIdInput.value.trim() === '') {
                alert('Please enter a student ID.');
                return;
            }

            studentIdInput.disabled = true;
            loginButton.disabled = true;

            snapButton.style.display = 'inline-block';
            snapButton.disabled = true; // Video hazır olana kadar devre dışı
            newStudentButton.style.display = 'inline-block';
            video.style.display = 'block';

            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: true });
                    video.srcObject = stream;
                    await video.play();
                } catch (error) {
                    console.error('Error accessing webcam:', error);
                    alert('Could not access webcam. Please make sure it is enabled and permissions are granted.');
                    // Hata durumunda geri al
                    studentIdInput.disabled = false;
                    loginButton.disabled = false;
                    video.style.display = 'none';
                    snapButton.style.display = 'none';
                    newStudentButton.style.display = 'none';
                }
            }
        });

        snapButton.addEventListener('click', () => {
            if (!videoReady) {
                alert('Please wait for the video to load.');
                return;
            }

            // Videoyu canvas'a çiz
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            // Canvas'ı JPEG olarak al
            const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
            const studentId = studentIdInput.value;

            // CSRF token'ı al
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // FormData kullan (daha güvenilir)
            const formData = new FormData();
            formData.append('studentId', studentId);
            formData.append('photo', dataUrl);
            
            fetch('/Home/SavePhoto', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token || ''
                },
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    alert(`Photo for student ${studentId} saved successfully!`);
                } else {
                    return response.text().then(text => {
                        console.error('Server response:', text);
                        alert('Error saving photo. Check console for details.');
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while saving the photo.');
            });
        });

        newStudentButton.addEventListener('click', () => {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }
            video.style.display = 'none';
            snapButton.style.display = 'none';
            newStudentButton.style.display = 'none';
            studentIdInput.disabled = false;
            loginButton.disabled = false;
            studentIdInput.value = '';
            context.clearRect(0, 0, canvas.width, canvas.height);
            videoReady = false;
        });
    </script>
}